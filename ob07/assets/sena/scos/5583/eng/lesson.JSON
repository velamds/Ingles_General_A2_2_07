{"_data": [{"contents": [{"content": "John Meets Sandra", "type": "lesson_name"}, {"content": "Falling for Her ", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work a", "type": "secondary_1"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_2"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_5"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_6"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_7"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le07ob07re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " The First Conditional", "type": "heading"}, {"content": " You use the  First Conditional to talk about real possibilities in the future.", "type": "describer"}, {"content": " You use the First Conditional to say it's possible that you will do something. In that condition, something else will happen.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If</span> Clause\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Main Clause\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If you cook the meat too long,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"it will burn.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible you will cook the meat too long. In this condition: it will burn.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If I ask the teacher to help me,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I will pass the test.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible I will ask the teacher to help me. In this condition: I will pass the test.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If he gets a high-paying job,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"he can go on a vacation twice a year.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible he will get a high-paying job. In this condition: he can go on vacation twice a year.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "exquisite", "type": "name"}, {"content": "very fine or high class", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I want to be taken to an exquisite restaurant for my birthday.", "type": "example"}, {"content": "engenn5le07ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to chat with colleagues.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to get to know each other", "type": "name"}, {"content": "to know more about each other from spending time together", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: John and Sandra go out for coffee to get to know each other.", "type": "example"}, {"content": "engenn5le07ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to be in charge of", "type": "name"}, {"content": "to have control of or responsibility for something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Sandra will be in charge of all the tours in the Caribbean.", "type": "example"}, {"content": "engenn5le07ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "excursion", "type": "name"}, {"content": "a short trip for fun", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: On a cruise, it's fun to take an excursion off the ship.", "type": "example"}, {"content": "engenn5le07ob07aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to coordinate", "type": "name"}, {"content": "to plan and manage details", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Sandra's job is to coordinate the tours on all the ships.", "type": "example"}, {"content": "engenn5le07ob07aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to transfer", "type": "name"}, {"content": "to change from one workplace to another", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If the company transfers Sandra, she may work in the city.", "type": "example"}, {"content": "engenn5le07ob07aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to miss someone", "type": "name"}, {"content": "to feel that you want to be with someone but you can't ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: If Sandra works in a city, John will miss her. ", "type": "example"}, {"content": "engenn5le07ob07aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Research on the web for major cruise ship lines and record the names of four companies.", "type": "text"}, {"content": "Select one of the companies that travels in the Caribbean. Take notes on the excursion tours they do.", "type": "text"}, {"content": "Describe one excursion in English to your partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I research about cruise ship lines and excursion tours.", "type": "text"}, {"content": "I take notes on specific information.", "type": "text"}, {"content": "I describe tours in detail in English.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le07ob07re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le07ob07re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">John</span>: Thank you for joining me on this delightful day.<br>\n<span class=\"strong\">Sandra</span>: Well, thank you for inviting me out to this exquisite cafe.<br>\n<span class=\"strong\">John</span>:  I hope we can get to know each other better.<br>\n<span class=\"strong\">Sandra</span>:  I would like that, John. So, how long ago did you start working on the ship?"}, {"image": "engenn5le07ob07re2img06.jpg", "time": "16000", "id": 2, "text": "<span class=\"strong\">John</span>: About six months ago. If I stay on, I 