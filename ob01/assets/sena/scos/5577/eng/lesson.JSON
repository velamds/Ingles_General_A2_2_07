{"_data": [{"contents": [{"content": "John Meets Sandra", "type": "lesson_name"}, {"content": "A Call From Peter ", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_1"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_2"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_3"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_4"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_5"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_6"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_7"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le07ob01re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "to float along", "type": "name"}, {"content": "to move slowly through something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: John is just floating along in his life on the ship.", "type": "example"}, {"content": "engenn5le07ob01aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about your job.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to wrap up", "type": "name"}, {"content": "to complete a task; to conclude an event", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Peter wrapped up a project at work last week.", "type": "example"}, {"content": "engenn5le07ob01aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "passenger", "type": "name"}, {"content": "a person who pays to ride on transportion, such as a bus, a ship or an airplane", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: John plans activities for passengers on the ship.", "type": "example"}, {"content": "engenn5le07ob01aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "presentation", "type": "name"}, {"content": "an activity where someone shows or explains something to a group of people ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Staff often give presentations to others for them to learn new things.", "type": "example"}, {"content": "engenn5le07ob01aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to pass with flying colors", "type": "name"}, {"content": "to pass a test with a good score", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I really hope I pass this test with flying colors.", "type": "example"}, {"content": "engenn5le07ob01aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "recruiter", "type": "name"}, {"content": "a person who finds suitable individuals to join a company", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Recruiters look for people with good grades.", "type": "example"}, {"content": "engenn5le07ob01aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "high-paying", "type": "name"}, {"content": "a job that pays a high salary", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: If Peter gets a high-paying job, he will go on a cruise next year.", "type": "example"}, {"content": "engenn5le07ob01aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "The First Conditional", "type": "heading"}, {"content": "You use the First Conditional to talk about real possibilities in the future.", "type": "describer"}, {"content": "You use the First Conditional to say it's possible that you will do something. In that condition, something else will happen.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" If Clause \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Main Clause \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If you cook the meat too long,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"it will burn.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible you will cook the meat too long. In this condition: it will burn.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If I ask the teacher to help me,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I will pass the test. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible I will ask the teacher to help me. In this condition: I will pass the test.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If he gets a high-paying job, \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"he can go on a vacation twice a year.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's possible he will get a high-paying job. In this condition: he can go on vacation twice a year.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Research and write down a good job you want in your field and how much you would like to earn.", "type": "text"}, {"content": "Write 4 sentences saying what you will do if you get a high-paying job.", "type": "text"}, {"content": "Ask your partner this question in English and compare your ideas: <span class=\"italic\">What will you do if you get a high-paying job?</span>", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I research better jobs.", "type": "text"}, {"content": "I write complete statements expressing possibilities.", "type": "text"}, {"content": "I ask questions about future possibilities.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le07ob01re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le07ob01re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Peter</span>: Hi, John. How is your adventure on the high seas?<br>\n<span class=\"strong\">John</span>: Well, I'm floating along. How's life on dry land?<br>\n<span class=\"strong\">Peter</span>: Pretty good. At my internship, I just wrapped up an important project. I'm learning a lot.<br>\n<span class=\"strong\">John</span>: Me too. I planned a lot of leisure activities for passengers. There's a lot going on."}, {"image": "engenn5le07ob01re2img05.jpg", "time": "20600", "id": 2, "text": "<span class=\"strong\">Peter</span>: Same here. I also gave a presentation to the rest of my team.<br>\n<span class=\"strong\">John</span>: Oh, yeah? You know, even on the ship, workshops are presented often. I met other colleagues for the first time that way."}, {"image": "engenn5le07ob01re2img06.jpg", "time": "33400", "id": 3, "text": "<span class=\"strong\">Peter</span>: Hey, final exams are coming up. I'm quite nervous.<br>\n<span class=\"strong\">John</span>: Oh, you'll pass with flying colors. <br>\n<span class=\"strong\">Peter</span>: If I get a good grade, I will be more attractive to recruiters. <br>\n<span class=\"strong\">John</span>: And if you get a high-paying job, you can come on a cruise and visit me."}], "audiosrc": "engenn5le07ob01re2aud01", "coverimg": "engenn5le07ob01re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about jobs and work.", "type": "Learning Outcomes"}, {"content": " I can talk or report about actions, events or people. ", "type": "Learning Outcomes"}, {"content": "I can talk about real possibilities and events in the future. ", "type": "Learning Outcomes"}, {"content": " Do you ever take courses for work?", "type": "Free Header Item"}, {"content": "How do you feel about exams? ", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": " Ask your partner:", "type": "free_header_text"}, {"content": " Learning more in your career.", "type": "free_type_text_area"}], "