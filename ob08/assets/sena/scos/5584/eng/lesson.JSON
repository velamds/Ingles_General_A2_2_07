{"_data": [{"contents": [{"content": "John Meets Sandra", "type": "lesson_name"}, {"content": "An Evaluation Form", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_3"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_4"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_5"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_6"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations.", "type": "secondary_7"}, {"content": "Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le07ob08re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Evaluation Form", "type": "heading"}, {"content": "An evaluation form is a form you complete after someone has presented a workshop or seminar.<br/>You give your opinion about the quality of the presentation.<br/><br/>Often, you have to circle number 1-5, 1 being most negative and 5 being the most positive.<br/><br/>Example:<br/><br/><span class=\"italic\">Would you recommend this course to others? .................. 1 2 3 <span class=\"strong\">4</span> 5 </span>", "type": "describer"}], "type": "learning_points"}, {"contents": [{"content": "to hold someone's interest", "type": "name"}, {"content": "to keep someone's attention ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Was your interest held at the presentation?", "type": "example"}, {"content": "engenn5le07ob08aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use when you talk about customer service.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to handle", "type": "name"}, {"content": "to deal with", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: How did you handle difficult customers?", "type": "example"}, {"content": "engenn5le07ob08aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to rate", "type": "name"}, {"content": "to make a judgment about the quality, ability, or value of something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Can you rate the presentation?", "type": "example"}, {"content": "engenn5le07ob08aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "disgruntled", "type": "name"}, {"content": "someone who is discontented and unhappy", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The disgruntled customers started yelling at the crew.", "type": "example"}, {"content": "engenn5le07ob08aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "loyalty", "type": "name"}, {"content": "a feeling of strong support for someone or something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Some customers really like loyalty programs.", "type": "example"}, {"content": "engenn5le07ob08aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Giving Opinions ", "type": "heading"}, {"content": "<p>When you complete an evaluation form, you give your opinion about products and the service you receive.</p> Here are some examples of how to give an opinion.<span class=\"italic\"><ul><li>I felt ... </li><li>I think/thought ...</li><li>I enjoyed/I didn't enjoy ... </li><li>I would recommend/I would not recommend ...</li></ul></span>", "type": "describer"}, {"content": "I felt that the employees were not trained properly.", "type": "example"}, {"content": "I thought that the speech was excellent but the room was too noisy.", "type": "example"}, {"content": "I enjoyed the lunch. It was delicious!", "type": "example"}, {"content": "I would recommend the course to other employees. ", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Create an evaluation form based on this lesson.", "type": "text"}, {"content": "Write five key points you want to rate. ", "type": "text"}, {"content": "Go to a restaurant or store and rate the customer service.", "type": "text"}, {"content": "Give the each key point a rating out of five.", "type": "text"}, {"content": "Write a sentence on each key point based on your opinion.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I create an evaluation form.", "type": "text"}, {"content": "I write down five key points I want to rate.", "type": "text"}, {"content": "I give a restaurant or store a rating out of five.", "type": "text"}, {"content": "I give my opinion.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn5le07ob08re2aud01", "images": [{"image": "engenn5le07ob08re2img01.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn5le07ob08re2img01.jpg", "id": 1, "time": "100", "text": "<span class=\"strong\">Sandra</span>: That concludes the presentation on customer service.</br>My assistant, Simone, will be handing out an evaluation form for you to complete.</br>\n<span class=\"strong\">John</span>: That was fantastic, Sandra. You really know your stuff.</br>\n<span class=\"strong\">Sandra</span>: Thanks, John. I worked in customer service for a long time."}, {"image": "engenn5le07ob08re2img05.jpg", "id": 2, "time": "21000", "text": "<span class=\"strong\">John</span>: How long did you work for Diego's? </br>\n<span class=\"strong\">Sandra</span>: Six years. I spent three years as a tour guide and two years in management.</br>\n<span class=\"strong\">John</span>: I particularly liked when you spoke about disgruntled customers.</br>\n<span class=\"strong\">Sandra</span>: Dealing with unhappy people is always a challenge. Patience and clear communication is key."}, {"image": "engenn5le07ob08re2img05.jpg", "id": 3, "time": "40000", "text": "<span class=\"strong\">John</span>: Also, your ideas about loyalty programs were a hit with the group.</br>\n<span class=\"strong\">Sandra</span>: They seem to encourage customers to come back year after year.</br>\n<span class=\"strong\">John</span>: I would definitely recommend anyone in hospitality to come to this presentation.</br>\n<span class=\"strong\">Sandra</span>: I hope you include this in your evaluation form.</br>\n<span class=\"strong\">John</span>: You bet! Aren't we all meeting up in the conference room for lunch now?"}], "coverimg": "engenn5le07ob08re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}, {"title": "", "contents": [{"value": {"images": [{"image": "", "id": 0, "time": "0", "text": ""}, {"image": "", "id": 1, "time": "1", "text": "<span class = \"bullet\">How does John complete the customer evaluation form?</span>"}, {"image": "", "id": 2, "time": "95000", "text": "<span class = \"bullet\">What additional comments does he include?</span>"}], "video_src": "engenn5le07ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "id": 2}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": " I can fill out an evaluation form. ", "type": "Learning Outcomes"}, {"content": " I can write a short text about work. ", "type": "Learning Outcomes"}, {"content": " I can write useful feedback.", "type": "Learning Outcomes"}, {"content": " Have you been to a presentation for work before? ", "type": "Free Header Item"}, {"content": " Did you have to fill out an evaluation form?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct"}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Writing Spot: John is attending a workshop on board his cruise ship.  Sandra is the guest speaker.", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"id": 1, "stimuli_ids": [1], "template_override": 1, "_data": [{"contents": [{"content": " Sandra just completed her presentation on customer service.<br/>What does John think of the information she pro